<Window x:Class="CameraUploaderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CameraUploaderApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="バケット選択" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket}"
                      Width="300" HorizontalAlignment="Left" />

            <!--ファイル一覧-->
            <TextBlock Text="ファイル一覧" Margin="0,10,10,0"/>

            <ListView ItemsSource="{Binding Files}" Height="250">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="選択" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ファイル名" Width="350"
                                        DisplayMemberBinding="{Binding Key}"/>
                        <GridViewColumn Header="更新日" Width="200"
                                        DisplayMemberBinding="{Binding LastModified}"/>
                        <GridViewColumn Header="サイズ（KB）" Width="100"
                                        DisplayMemberBinding="{Binding ObjectSize}"/>
                    </GridView>
                    
                
                </ListView.View>
            </ListView>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!--左側のボタン-->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="アップロード" Command="{Binding UploadCommand}" Margin="5" Width="100"/>
                    <Button Content="ダウンロード" Command="{Binding DownloadCommand}" Margin="5" Width="100"/>
                    <Button Content="削除" Command="{Binding DeleteCommand}" Margin="5" Width="50"/>
                </StackPanel>
                
                <!--右側のボタン-->
                <StackPanel Grid.Column="1">
                    <Button Content="次へ" Command="{Binding NextPageCommand}"  Margin="5" Width="50"/>
                </StackPanel>
            </Grid>
            
            
            <ProgressBar Minimum="0" Maximum="100"
                         Height="20" Margin="10"
                         Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
